# Neon Postgres connection string (use the pooled/`-pooler` host for serverless).
# Neon console -> your project -> Connect -> copy the connection string.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# The app rewrites a direct Neon host to its `-pooler` equivalent automatically.
# Set NEON_POOLER=off only if your project has no pooler endpoint.
NEON_POOLER=auto

# HMAC key for signing QR passes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QR_SECRET=

# Initial admin login created by `npm run db:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: email QR passes to verified teams (Resend).
RESEND_API_KEY=
RESEND_FROM="Code Spark 2026 <ops@yourdomain.com>"

# Optional: raises GitHub API rate limits for repo/commit checks.
GITHUB_TOKEN=

# Optional: shared secret so an external scheduler can trigger repo syncs:
#   curl -X POST https://<host>/api/admin/repo-sync -H "x-repo-sync-token: <token>" \
#        -H "content-type: application/json" -d '{"limit": 60}'
REPO_SYNC_TOKEN=
